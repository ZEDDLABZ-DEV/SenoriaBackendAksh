{
  "name": "senoria-caregiver-api",
  "version": "1.0.0",
  "private": true,
  "description": "Caregiver API for Senoria Seniors. Independent of the Flutter apps and the admin web portal.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/assert-migrations-preserve-constraints.ts && prisma migrate deploy && prisma db execute --file prisma/preserve-constraints.sql --schema prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:local": "sh scripts/dev-database.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
