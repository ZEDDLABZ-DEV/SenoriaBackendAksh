# Copy to .env and replace every placeholder. Do not commit .env.
# These values are examples only. They are not credentials.

PORT=3000
NODE_ENV=development

# Application database. Use a dedicated database. Do not point this at production
# while running tests or the development seed.
DATABASE_URL=postgresql://senoria:password@127.0.0.1:5432/senoria

# Isolated database whose name contains "test". The test suite refuses to run
# against any other database, and it truncates this database.
TEST_DATABASE_URL=postgresql://senoria:password@127.0.0.1:5432/senoria_test

# At least 32 random characters each. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
REFRESH_TOKEN_PEPPER=replace-with-a-different-random-string-at-least-32-characters

# Comma-separated browser origins for the future admin portal.
# The Flutter app does not need CORS. Leave empty to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:5173

# First administrator. Used only by `npm run admin:bootstrap`.
# The command refuses to run if an administrator already exists, and it never prints the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Development caregiver seed. Used only by `npm run db:seed`.
# The plaintext password is read at runtime and is not written into the repository.
SEED_CAREGIVER_EMAIL=
SEED_CAREGIVER_PASSWORD=
SEED_CAREGIVER_FIRST_NAME=
SEED_CAREGIVER_LAST_NAME=
SEED_CAREGIVER_PHONE=

# Firebase Admin service account used only to send visit-coverage pushes.
# Paste the service account JSON on one line, or set a path to a JSON file that is not in this repo.
# Leave empty to keep in-app notifications without phone push. Do not commit the service account file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Sales integrations. Leave every flag unset or not "true", and leave secrets empty,
# until that vendor should run. enabled requires the flag to be true AND every
# required variable for that vendor to be non-empty.
# Meta lead ads call Graph when Meta is enabled.
# Zoho CRM is updated after a sales note is saved, and only when Zoho is enabled.

# Meta lead ads. Webhook: GET and POST /api/v1/webhooks/meta/leads
# Required when enabled: APP_ID, APP_SECRET, PAGE_ID, PAGE_ACCESS_TOKEN, WEBHOOK_VERIFY_TOKEN.
# APP_SECRET verifies X-Hub-Signature-256. WEBHOOK_VERIFY_TOKEN answers the hub challenge.
# PAGE_ACCESS_TOKEN loads lead details from Graph. See docs/INTEGRATIONS.md for the field map.
META_LEADS_ENABLED=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_LEAD_FIELD_MAP=
META_LEAD_FIELD_MAP_FILE=

# RingCentral click-to-call and call log. See docs/INTEGRATIONS.md.
# Required when enabled: CLIENT_ID, CLIENT_SECRET, SERVER_URL, JWT, ACCOUNT_ID, EXTENSION_ID, FROM_NUMBER.
# SERVER_URL is https://platform.ringcentral.com or https://platform.devtest.ringcentral.com.
# JWT is the app JWT credential. The API exchanges it with the JWT bearer grant. It is not sent to clients.
# ACCOUNT_ID and EXTENSION_ID may be ~ for the authenticated account and extension.
# FROM_NUMBER is the RingOut caller number. WEBHOOK_VERIFICATION_TOKEN is optional.
# Webhook: POST /api/v1/webhooks/ringcentral/calls
RINGCENTRAL_ENABLED=
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_SERVER_URL=
RINGCENTRAL_JWT=
RINGCENTRAL_ACCOUNT_ID=
RINGCENTRAL_EXTENSION_ID=
RINGCENTRAL_FROM_NUMBER=
RINGCENTRAL_WEBHOOK_VERIFICATION_TOKEN=

# Zoho CRM. See docs/INTEGRATIONS.md.
# Note push (ZOHO_ENABLED) needs CLIENT_ID, CLIENT_SECRET, REFRESH_TOKEN, ACCOUNTS_DOMAIN, API_DOMAIN.
# Optional ZOHO_CRM_MODULE is Leads (default) or Contacts.
# Inbound leads: POST /api/v1/webhooks/zoho/leads with header X-Zoho-Webhook-Secret.
# ZOHO_INBOUND_ENABLED and ZOHO_OUTBOUND_ENABLED default off. Outbound lead push is a no-op.
# Canada DC (Senoria Senior Health & Living Inc., crmplus org110003644353):
# ZOHO_ACCOUNTS_DOMAIN=accounts.zohocloud.ca
# ZOHO_API_DOMAIN=www.zohoapis.ca
# Production webhook: POST https://<api-host>/api/v1/webhooks/zoho/leads
ZOHO_ENABLED=
ZOHO_INBOUND_ENABLED=
ZOHO_OUTBOUND_ENABLED=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=
ZOHO_API_DOMAIN=
ZOHO_CRM_MODULE=
ZOHO_WEBHOOK_SECRET=
ZOHO_LEAD_MAP=
ZOHO_LEAD_MAP_FILE=

# Outlook calendar. App-only Microsoft Graph. See docs/INTEGRATIONS.md.
# Required when enabled: CLIENT_ID, CLIENT_SECRET, TENANT_ID, CALENDAR_USER.
# CALENDAR_USER is the mailbox UPN whose calendar receives sales meetings.
# Each OUTLOOK_ name may be set as MICROSOFT_ instead. OUTLOOK_ wins when both are set.
# MICROSOFT_ENABLED is used only when OUTLOOK_ENABLED is empty.
OUTLOOK_ENABLED=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_CALENDAR_USER=
