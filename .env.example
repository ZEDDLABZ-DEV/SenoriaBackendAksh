# Copy to .env and replace every placeholder. Do not commit .env.
# These values are examples only. They are not credentials.

PORT=3000
NODE_ENV=development

# Application database. Use a dedicated database. Do not point this at production
# while running tests or the development seed.
DATABASE_URL=postgresql://senoria:password@127.0.0.1:5432/senoria

# Isolated database whose name contains "test". The test suite refuses to run
# against any other database, and it truncates this database.
TEST_DATABASE_URL=postgresql://senoria:password@127.0.0.1:5432/senoria_test

# At least 32 random characters each. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
REFRESH_TOKEN_PEPPER=replace-with-a-different-random-string-at-least-32-characters

# Comma-separated browser origins for the future admin portal.
# The Flutter app does not need CORS. Leave empty to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:5173

# First administrator. Used only by `npm run admin:bootstrap`.
# The command refuses to run if an administrator already exists, and it never prints the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Development caregiver seed. Used only by `npm run db:seed`.
# The plaintext password is read at runtime and is not written into the repository.
SEED_CAREGIVER_EMAIL=
SEED_CAREGIVER_PASSWORD=
SEED_CAREGIVER_FIRST_NAME=
SEED_CAREGIVER_LAST_NAME=
SEED_CAREGIVER_PHONE=

# Firebase Admin service account used only to send visit-coverage pushes.
# Paste the service account JSON on one line, or set a path to a JSON file that is not in this repo.
# Leave empty to keep in-app notifications without phone push. Do not commit the service account file.
FIREBASE_SERVICE_ACCOUNT_JSON=
